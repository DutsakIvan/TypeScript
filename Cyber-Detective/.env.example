# Copy this file to .env.local for local development.
# Never commit real API keys to GitHub.

# Server-only Gemini key used by /api/gemini/chat
GEMINI_API_KEY=

# Optional legacy client key; leave empty for GitHub Pages builds.
VITE_GEMINI_API_KEY=

# Optional Google Maps proxy settings if MapView is used.
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
